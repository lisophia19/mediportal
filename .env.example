# Copy to .env and fill in real values. Never commit .env.

# Postgres connection used by docker-compose and the Flask backend.
POSTGRES_DB=mediportal
POSTGRES_USER=mediportal
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://mediportal:change-me@localhost:5432/mediportal

# Signing secret for dashboard JWTs (spec §5.8).
JWT_SECRET=change-me

# API key for the LLM used in complaint-to-term matching (spec §5.1).
LLM_API_KEY=change-me

# Selects the SchedulingProvider implementation (spec §5.5a). "postgres" is
# the baseline; a future real-EHR provider drops in via this flag alone.
SCHEDULING_PROVIDER=postgres

# Base URL the frontend uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:5000/api/v1
