# Copy to .env and fill in real values. Never commit .env.

# Postgres connection used by docker-compose and the Flask backend.
POSTGRES_DB=mediportal
POSTGRES_USER=mediportal
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://localhost/mediportal

# Signing secret for dashboard JWTs (spec §5.8) and the shared-secret header
# Vogent-facing routes require (spec §5 intro) -- exact names config.py reads.
SECRET_KEY=change-me
AGENT_KEY=change-me

# Anthropic API key used for complaint-to-term matching (spec §5.1). Read
# automatically by the `anthropic` SDK -- this exact name is required.
ANTHROPIC_API_KEY=change-me
# Model override for the matching call (spec §5.1); default is claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# Selects the SchedulingProvider implementation (spec §5.5a). "postgres" is
# the baseline; a future real-EHR provider drops in via this flag alone.
SCHEDULING_PROVIDER=postgres

# Base URL the frontend uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Vogent (the phone agent) -- Phase 2, not wired up yet. VOGENT_API_KEY is
# only needed here if we end up calling Vogent's API from this backend
# (e.g. to manage the agent config programmatically); the flow calling INTO
# our API uses AGENT_KEY/X-Agent-Key instead (see backend/.env.example), a
# separate secret.
VOGENT_AGENT_ID=cceb0375-1c3d-4437-936a-741b394e1b78
VOGENT_API_KEY=change-me
